  .p-cartas { position: relative; width: 100%; height: 12.6vw; perspective: 70vw; }
  .carta { position: absolute; left: 50%; top: 50%; width: 9.6vw; border-radius: 1vw; padding: .5vw .5vw .7vw;
    background: color-mix(in srgb, var(--fg) 9%, rgb(18 20 26 / .72)); border: 1px solid color-mix(in srgb, var(--fg) 20%, transparent);
    box-shadow: 0 2vw 4vw -1vw rgb(0 0 0 / .6), inset 0 1px 0 rgb(255 255 255 / .12);
    transform: translate(-50%, -50%) translateX(var(--dx, 0)) scale(var(--s, 1)) rotateY(var(--ry, 0deg)); opacity: var(--o, 1);
    transition: transform .8s var(--entrada, ease), opacity .8s ease; }
  .carta img, .carta .sem-capa { display: block; width: 100%; aspect-ratio: 1; border-radius: .65vw; object-fit: cover; background: var(--vidro); }
  .carta .sem-capa { display: grid; place-items: center; color: var(--fraco); font-size: 3vw; }
  .carta b { display: block; margin-top: .5vw; font-size: .82vw; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: center; }
  .carta small { display: block; margin-top: .15vw; font-size: .66vw; color: var(--suave); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: center; }
  .carta.c0 { z-index: 5; } .carta.l1, .carta.r1 { z-index: 4; } .carta.l2, .carta.r2 { z-index: 3; }
  .carta.l1 { --dx: -6.6vw; --s: .8; --ry: 24deg; --o: .92; } .carta.r1 { --dx: 6.6vw; --s: .8; --ry: -24deg; --o: .92; }
  .carta.l2 { --dx: -11vw; --s: .62; --ry: 34deg; --o: .5; } .carta.r2 { --dx: 11vw; --s: .62; --ry: -34deg; --o: .5; }
  .carta:not(.c0) b, .carta:not(.c0) small { opacity: .75; }
  .p-barra { position: relative; width: 29vw; height: 4.4vw; border-radius: 2.2vw; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1vw;
    padding: 0 1.4vw; background: color-mix(in srgb, var(--fg) 8%, rgb(18 20 26 / .6)); border: 1px solid color-mix(in srgb, var(--fg) 16%, transparent);
    box-shadow: 0 1.4vw 3vw -1vw rgb(0 0 0 / .55), inset 0 1px 0 rgb(255 255 255 / .1); }
  .p-ctl { display: flex; align-items: center; gap: 1.1vw; color: var(--fg); }
  .p-ctl svg { width: 1.3vw; height: 1.3vw; fill: currentColor; }
  .p-ctl .pp svg { width: 1.5vw; height: 1.5vw; }
  .p-ctl .apagado { opacity: .45; }
  .p-agora { display: grid; grid-template-columns: 2.8vw 1fr auto; align-items: center; gap: .8vw; min-width: 0; height: 3.4vw; padding: .3vw .9vw .3vw .3vw;
    border-radius: 1vw; background: rgb(10 11 15 / .72); position: relative; overflow: hidden; }
  .p-agora img, .p-agora .mini { width: 2.8vw; height: 2.8vw; border-radius: .6vw; object-fit: cover; background: var(--vidro); }
  .p-agora .tx { min-width: 0; }
  .p-agora .tx b { display: block; font-size: .95vw; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .p-agora .tx span { display: block; font-size: .78vw; color: var(--suave); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .p-agora .tempo-m { font-size: .75vw; color: var(--fraco); font-variant-numeric: tabular-nums; }
  .p-agora .prog { position: absolute; left: .6vw; right: .6vw; bottom: .25vw; height: 2px; border-radius: 2px; background: rgb(255 255 255 / .12); overflow: hidden; }
  .p-agora .prog i { position: absolute; inset: 0; background: var(--fg); transform-origin: left; transform: scaleX(var(--p, 0)); transition: transform 1s linear; }
  .onda { display: flex; align-items: center; gap: .18vw; height: 1.2vw; }
  .onda i { width: .16vw; height: 100%; border-radius: 1px; background: var(--fg); opacity: .8; transform-origin: center; transform: scaleY(.3); }
  body.tocando.ativo-som .onda i { animation: eq 1.1s ease-in-out infinite; }
  .onda i:nth-child(2) { animation-delay: -.3s !important; } .onda i:nth-child(3) { animation-delay: -.6s !important; } .onda i:nth-child(4) { animation-delay: -.15s !important; } .onda i:nth-child(5) { animation-delay: -.45s !important; }
  @keyframes eq { 0%, 100% { transform: scaleY(.25); } 50% { transform: scaleY(1); } }
  body.pausa-musica .onda i { animation: none !important; }
  .p-dir { display: flex; align-items: center; gap: 1.1vw; color: var(--suave); }
  .p-dir svg { width: 1.25vw; height: 1.25vw; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  /* Porta-retrato */
  .retrato { position: relative; width: 22vw; aspect-ratio: 4 / 5; border-radius: 1.6vw; overflow: hidden;
    background: var(--vidro); border: 1px solid var(--linha);
    box-shadow: 0 2.5vw 5vw -1vw rgb(0 0 0 / .65), 0 0 0 .5vw color-mix(in srgb, var(--fg) 4%, transparent); }
  .retrato img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 35%; opacity: 0;
    transition: opacity 1.4s ease-in-out; will-change: transform, opacity; }
  .retrato img.ativa { opacity: 1; animation: kenburns 10s ease-out forwards; }
  @keyframes kenburns { from { transform: scale(1.05); } to { transform: scale(1); } }
  .retrato::after { content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / .06), inset 0 -8vw 6vw -6vw rgb(0 0 0 / .35); }
  .vazio { position: absolute; inset: 1.2vw; border: 2px dashed var(--linha); border-radius: 1vw; display: grid;
    place-content: center; justify-items: center; gap: .8vw; text-align: center; color: var(--fraco); font-size: 1vw; padding: 2vw; }
  .vazio svg { width: 4vw; height: 4vw; }
  .vazio code { font-family: "JetBrainsMono Nerd Font", monospace; font-size: .85vw; color: var(--suave); }

  /* Coluna de informações */
  .info { display: grid; justify-items: start; }
  .hora { font-size: 9.6vw; font-weight: 300; letter-spacing: -.035em; line-height: .9; display: flex; align-items: flex-start;
    font-variant-numeric: tabular-nums; text-shadow: 0 .3vw 3vw rgb(0 0 0 / .4); }
  .digito { position: relative; display: inline-block; width: .58em; height: 1.02em; overflow: hidden; text-align: center; }
  .digito span { position: absolute; inset: 0; }
  .digito .sai { animation: sai .75s var(--entrada) forwards; }
  .digito .entra { animation: entra .75s var(--entrada) forwards; }
  @keyframes sai { to { transform: translateY(-70%); opacity: 0; } }
  @keyframes entra { from { transform: translateY(70%); opacity: 0; } to { transform: none; opacity: 1; } }
  .seg-dig { font-size: .34em; width: .6em; margin-top: .2em; color: var(--suave); font-weight: 400; }
  .seg-dig .entra, .seg-dig .sai { animation-duration: .5s; }
  .sep-seg { width: .12em; }
  .doispontos { width: .28em; text-align: center; animation: pulsar 2s ease-in-out infinite; }
  @keyframes pulsar { 50% { opacity: .3; } }

  /* Segundos: linha fina que enche em 60 s. */
  .segundos { width: 100%; height: 3px; border-radius: 3px; background: var(--linha); overflow: hidden; margin: 1.4vw 0 1.2vw; }
  .segundos i { display: block; height: 100%; background: var(--fg); transform-origin: left; animation: encher 60s linear infinite;
    box-shadow: 0 0 10px var(--fg); }
  @keyframes encher { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .data { font-size: 2vw; color: var(--suave); font-weight: 400; }
  .data b { color: var(--fg); font-weight: 500; }

  .clima { display: flex; align-items: center; gap: 1.1vw; margin-top: 2.6vw; }
  .clima .icone { width: 3.6vw; height: 3.6vw; }
  .clima .temp { font-size: 3.4vw; font-weight: 300; line-height: 1; }
  .clima .txt { display: grid; gap: .25vw; }
  .clima .cond { font-size: 1.45vw; }
  .clima .extra { font-size: 1.05vw; color: var(--fraco); display: flex; gap: .9vw; }
  .clima .extra .radar { color: #9fd3ff; }

  .dias { display: flex; gap: .9vw; margin-top: 1.6vw; }
  .dia { display: grid; grid-template-columns: auto auto; align-items: center; column-gap: .7vw; row-gap: .1vw;
    padding: .75vw 1.1vw; border-radius: .9vw; background: color-mix(in srgb, var(--bg) 55%, transparent); border: 1px solid var(--linha);
    font-size: .95vw; color: var(--suave); }
  .dia .icone { width: 2vw; height: 2vw; grid-row: span 2; }
  .dia b { font-weight: 500; color: var(--fg); }
  .dia small { font-size: .8vw; color: var(--fraco); }

  /* Entrada em cascata */
  .surge { opacity: 0; animation: surgir 1.2s var(--entrada) forwards; animation-delay: calc(var(--i) * 130ms + 120ms); }
  @keyframes surgir { from { opacity: 0; transform: translateY(1.4vw); } to { opacity: 1; transform: none; } }

  /* Ícone de traço (só o porta-retrato vazio) */
  .linha * { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }

  /* Tela estreita (prévia no celular): empilha. */
  @media (max-aspect-ratio: 1/1) {
    .palco { grid-template-columns: 1fr; justify-items: center; gap: 8vw; }
    .retrato { width: 62vw; border-radius: 5vw; }
    .info { justify-items: center; }
    .hora { font-size: 26vw; } .data { font-size: 5vw; } .segundos { width: 70vw; }
    .clima .icone { width: 9vw; height: 9vw; } .clima .temp { font-size: 9vw; } .clima .cond { font-size: 4vw; }
    .clima .extra { font-size: 3vw; } .dia { font-size: 2.8vw; padding: 2vw 3vw; border-radius: 3vw; } .dia .icone { width: 6vw; height: 6vw; }
    .dia small { font-size: 2.4vw; } .vazio { font-size: 3vw; } .vazio code { font-size: 2.4vw; } .vazio svg { width: 10vw; height: 10vw; }
  }
  /* ── Céu: camada atrás do conteúdo, posição real do sol/lua. */
  .tom { position: fixed; inset: 0; transition: background 3s ease; pointer-events: none; }
  [data-periodo="dia"] .tom { background: linear-gradient(to bottom, rgb(255 244 220 / .05), transparent 60%); }
  [data-periodo="amanhecer"] .tom { background: linear-gradient(to top, rgb(255 170 90 / .16), rgb(255 120 140 / .05) 45%, transparent 75%); }
  [data-periodo="entardecer"] .tom { background: linear-gradient(to top, rgb(255 120 50 / .2), rgb(160 70 160 / .08) 45%, transparent 80%); }
  [data-periodo="noite"] .tom { background: linear-gradient(to bottom, rgb(30 50 110 / .28), rgb(10 15 40 / .12) 60%, transparent); }
  .ceu { position: fixed; inset: 0; pointer-events: none; }
  .ceu .arco { position: absolute; inset: 0; width: 100%; height: 100%; }
  .horizonte { stroke: var(--linha); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .trilha { fill: none; stroke: var(--fg); stroke-opacity: .42; stroke-width: 2.2; stroke-dasharray: 2 8; stroke-linecap: round;
    vector-effect: non-scaling-stroke; }
  @keyframes tracejar { to { stroke-dashoffset: -180; } }
  .trilha-feita { fill: none; stroke: var(--fg); stroke-opacity: .7; stroke-width: 2.4; stroke-linecap: round; vector-effect: non-scaling-stroke;
    animation: aparecer-trilha 2.4s ease .4s both; }
  .trilha-brilho { fill: none; stroke: var(--fg); stroke-opacity: .18; stroke-width: 9; stroke-linecap: round; vector-effect: non-scaling-stroke;
    filter: blur(4px); animation: aparecer-trilha 2.4s ease .4s both; }
  @keyframes aparecer-trilha { from { opacity: 0; } }
  .previa .trilha-feita, .previa .trilha-brilho { animation: none; }
  .previa *, .previa *::before { transition: none !important; }
  .marco { position: absolute; left: var(--x); top: var(--y); translate: -50% -50%; display: grid; justify-items: center; gap: .5vw; }
  .marco i { width: .6vw; aspect-ratio: 1; border-radius: 50%; background: var(--fg); opacity: .8; box-shadow: 0 0 .8vw var(--fg); }
  .marco span { font-size: .85vw; color: var(--suave); letter-spacing: .04em; white-space: nowrap; translate: 0 .9vw; }
  .astro { position: absolute; left: var(--x); top: var(--y); translate: -50% -50%; animation: subir 2.4s var(--entrada) both .4s; }
  @keyframes subir { from { top: 88%; opacity: 0; } to { opacity: 1; } }
  .sol i { display: block; width: 2.6vw; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, #fff 0 38%, rgb(255 236 190 / .9) 46%, transparent 72%);
    box-shadow: 0 0 3vw 1vw rgb(255 230 170 / .35), 0 0 9vw 3vw rgb(255 210 140 / .14); animation: brilhar 5s ease-in-out infinite; will-change: transform; }
  @keyframes brilhar { 50% { transform: scale(1.1); } }
  .lua .lua-svg { display: block; width: 4.2vw; overflow: visible; }
  .lua::before { content: ""; position: absolute; inset: -60%; border-radius: 50%; z-index: -1;
    background: radial-gradient(circle, rgb(220 230 255 / .28), rgb(220 230 255 / .08) 40%, transparent 68%); }
  .lua-escura { fill: rgb(200 210 230 / .07); }
