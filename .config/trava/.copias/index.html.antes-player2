    animation: brota .3s cubic-bezier(.34, 1.6, .5, 1) both; }
  .pontos .caret { width: 2px; height: 1.4vw; background: var(--fg); border-radius: 2px; animation: piscar-c 1.1s steps(1) infinite; }
  .pontos .mais { font-size: .9vw; color: var(--suave); }
  .porta .dica { margin-top: 1.4vw; font-size: .95vw; letter-spacing: .04em; color: var(--fraco); min-height: 1.3vw; }
  .porta .aviso-caps { margin-top: .8vw; }
  /* verificando: brilho corre pela linha; pontos em onda */
  [data-senha="verificando"] .trilho-senha .fio-cor { opacity: .9; transform: none; width: 30%; left: -30%; right: auto;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--fg) 90%, transparent), transparent); animation: varre 1s ease-in-out infinite; }
  @keyframes varre { to { transform: translateX(433%); } }
  [data-senha="verificando"] .pontos i { animation: onda .9s ease-in-out infinite; animation-delay: calc(var(--k) * 60ms); }
  /* erro */
  [data-senha="erro"] .entrada { animation: tremer .5s cubic-bezier(.36, .07, .19, .97) both; }
  [data-senha="erro"] .trilho-senha .fio { background: linear-gradient(90deg, transparent, rgb(232 131 139 / .9) 15%, rgb(232 131 139 / .9) 85%, transparent); }
  [data-senha="erro"] .entrada .cad * { stroke: #e8838b; }
  [data-senha="erro"] .porta .dica { color: #e8838b; }
  /* acerto: cadeado abre verde, linha enche do centro, relógio sobe como cortina */
  [data-senha="ok"] .entrada .cad * { stroke: #8ff0b8; }
  [data-senha="ok"] .entrada .cad .alca { transform: translate(3.5px, -3px) rotate(28deg); }
  [data-senha="ok"] .trilho-senha .fio-cor { opacity: 1; animation: enche .5s cubic-bezier(.65, 0, .35, 1) .1s forwards; }
  @keyframes enche { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  [data-senha="ok"] .pontos i { background: #a8f5c8; box-shadow: 0 0 .8vw rgb(111 224 160 / .7); animation: recolhe .45s cubic-bezier(.6, 0, .4, 1) .05s forwards; }
  [data-senha="ok"] .porta .dica { color: #8ff0b8; }
  [data-senha="ok"] .porta { transform: translateY(-4vw); opacity: 0; transition: transform .55s cubic-bezier(.6, 0, .3, 1) .55s, opacity .4s ease .65s; }
  [data-senha="ok"] .cofre { opacity: 0; transition: opacity .45s ease .7s; }

  .pausado, .pausado * { animation-play-state: paused !important; }
  .previa .surge, .previa .astro { animation: none; opacity: 1; }
</style>
