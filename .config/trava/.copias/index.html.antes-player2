    backdrop-filter: blur(18px) saturate(140%);
    box-shadow: 0 3.5vw 7vw -2vw rgb(0 0 0 / .7), inset 0 1px 0 rgb(255 255 255 / .09), inset 0 -1px 0 rgb(0 0 0 / .25);
    transform: translateY(1.2vw) scale(.96); transition: transform .55s cubic-bezier(.2, .8, .2, 1), border-color .4s ease; will-change: transform; }
  body.senha-aberta .cartao { transform: none; }
  /* Selo de vidro com cadeado: anel gira ao verificar; no acerto o anel se desenha em verde e o cadeado abre */
  .selo { position: relative; width: 4.4vw; aspect-ratio: 1; display: grid; place-items: center; }
  .selo .vidro, .selo .anel-v, .selo .onda { display: none; }
  .brilho-ok { position: absolute; inset: -1.6vw; border-radius: 50%; opacity: 0; transform: scale(.6);
    background: radial-gradient(circle, rgb(111 224 160 / .45), rgb(111 224 160 / .12) 45%, transparent 70%); }
  [data-senha="ok"] .brilho-ok { animation: brilho-ok 1s cubic-bezier(.2, .8, .2, 1) .2s forwards; }
  @keyframes brilho-ok { 40% { opacity: 1; transform: scale(1.1); } to { opacity: .55; transform: scale(1); } }
  [data-senha="verificando"] .cad { animation: pulsa-cad .9s ease-in-out infinite; }
  @keyframes pulsa-cad { 50% { transform: scale(.9); opacity: .6; } }
  .selo .vidro { position: absolute; inset: .5vw; border-radius: 50%;
    background: radial-gradient(circle at 35% 28%, color-mix(in srgb, var(--fg) 20%, transparent), color-mix(in srgb, var(--fg) 4%, transparent) 72%);
    border: 1px solid color-mix(in srgb, var(--fg) 18%, transparent);
