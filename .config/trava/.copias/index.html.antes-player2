  @keyframes tremer { 10%, 90% { transform: translateX(-2px); } 20%, 80% { transform: translateX(4px); } 30%, 50%, 70% { transform: translateX(-8px); } 40%, 60% { transform: translateX(8px); } }
  [data-senha="ok"] .cartao { transform: scale(1.04); opacity: 0; transition: transform .45s cubic-bezier(.4, 0, .2, 1) .62s, opacity .35s ease .66s; }
