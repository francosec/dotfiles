  .trilha-lua { stroke-dasharray: 1 6; stroke-opacity: .25; }
  @keyframes pairar { to { translate: 0 -.3vw; } }
  .estrelas { position: absolute; left: 0; right: 0; top: 0; height: 82%; }
  .estrelas .campo { position: absolute; inset: 0; background-size: 100% 100%; will-change: opacity; }
  .campo.c1 { background-image: var(--estrelas-1); animation: piscam 4s ease-in-out infinite; }
  .campo.c2 { background-image: var(--estrelas-2); animation: piscam 5.5s ease-in-out infinite 1.3s; }
  .campo.c3 { background-image: var(--estrelas-3); animation: piscam 7s ease-in-out infinite 2.6s; }
  [data-periodo="amanhecer"] .estrelas, [data-periodo="entardecer"] .estrelas { opacity: .4; }
  @keyframes piscam { 0%, 100% { opacity: .25; } 50% { opacity: .9; } }
  .cadente { position: absolute; top: 12%; left: 70%; width: 9vw; height: 2px; border-radius: 2px; opacity: 0; rotate: -28deg;
    background: linear-gradient(to left, #fff, transparent); animation: cadente 23s ease-in infinite 6s; }
  @keyframes cadente { 0%, 94% { opacity: 0; transform: translateX(0); } 95% { opacity: 1; } 100% { opacity: 0; transform: translateX(-28vw); } }

  .saudacao { font-size: 1.5vw; color: var(--suave); letter-spacing: .02em; margin-bottom: .6vw; }
  .chip-ceu { display: flex; align-items: center; gap: .8vw; margin-top: 1.4vw; font-size: 1vw; color: var(--fraco); }
  .chip-ceu b { color: var(--suave); font-weight: 500; }
  .mini-sol { width: 1.3vw; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, #fff 0 40%, rgb(255 225 160 / .8) 55%, transparent 72%); }
  .mini-lua .lua-svg { width: 1.5vw; display: block; }

  /* ── Senha: ao mexer o mouse/teclar, a tela desfoca e o cartão de vidro assume o foco. */
  /* Só opacity/transform animam (a GPU compõe sem redesenhar). O desfoque do fundo entra de uma vez,
     escondido pelo esmaecer; animar o raio do blur em 2560x1440 é o que travava os quadros. */
  .palco, .ceu, .ambiente { transition: opacity .55s cubic-bezier(.2, .8, .2, 1), transform .55s cubic-bezier(.2, .8, .2, 1);
    will-change: opacity, transform; }
  body.senha-aberta .palco { opacity: .05; transform: scale(.95); }
  body.senha-aberta .ceu, body.senha-aberta .ambiente { opacity: .22; }
  /* Com a senha aberta tudo atrás pausa (versão aprovada; manter o céu andando custava quadros na abertura). */
  body.senha-aberta .ceu *, body.senha-aberta .ambiente *, body.senha-aberta .palco *, body.senha-aberta .fundo { animation-play-state: paused !important; }
  body.senha-aberta .onda i { animation: none !important; }
  .cofre { position: fixed; inset: 0; display: grid; place-items: center; pointer-events: none; opacity: 0;
