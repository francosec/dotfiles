<script>window.CEU_GEO = { horizonte: 19, topo: 4, abaixo: 2.4 };   // céu em faixa no alto: não cruza foto nem textos</script>
<script src="ceu.js"></script>
<script src="tempo.js"></script>
<script>
  if (location.search.includes('previa')) document.body.classList.add('previa');

  // ── Porta-retrato: fotos de ~/Pictures/porta-retrato (lista em trava-fotos.js), troca suave a cada 8 s.
  // A próxima foto é decodificada antes da troca (sem tranco no quadro); com o campo de senha aberto, não troca.
  const ret = document.getElementById('retrato'), fotos = window.FOTOS || [];
  if (!fotos.length) {
    ret.innerHTML = `<div class="vazio"><svg class="linha" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="2"/><path d="M21 16l-5-5-9 9"/></svg>
      <span>Coloque fotos em</span><code>~/Pictures/porta-retrato</code></div>`;
  } else {
    const imgs = fotos.map(src => { const i = new Image(); i.src = src; i.decoding = 'async'; ret.append(i); return i; });
    let n = 0;
    const mostrar = () => { imgs.forEach((im, i) => im.classList.toggle('ativa', i === n)); };
    // Reinicia o Ken Burns a cada troca.
    const proxima = async () => {
      if (document.body.classList.contains('senha-aberta')) return;
      const k = (n + 1) % imgs.length;
      try { await imgs[k].decode(); } catch { return; }      // foto com defeito: fica na atual
      const v = imgs[n]; n = k; v.classList.remove('ativa'); void imgs[n].offsetWidth; mostrar();
    };
    mostrar(); if (imgs.length > 1) setInterval(proxima, 8000);
  }

  const icone = (c, noite) => window.iconeTempo(c, noite);

  // ── Player: recebe do trava-saver (playerctl/MPRIS) a faixa atual e as últimas tocadas.
  //    Tocando: o player toma o lugar do porta-retrato; pausado por mais de 20 s ou sem player: volta a foto.
  {
    const $p = id => document.getElementById(id), esc = t => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
    const SPOTIFY = '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="currentColor" opacity=".9"/><path d="M6.5 9.3c3.8-1.1 8-.8 11.2 1M7.2 12.4c3.1-.8 6.4-.5 9.1.9M7.9 15.3c2.4-.6 4.9-.4 7 .7" fill="none" stroke="#14161c" stroke-width="1.6" stroke-linecap="round"/></svg>';
    const PLAY = '<svg viewBox="0 0 24 24"><path d="M7 4.5v15l12.5-7.5z"/></svg>', PAUSA = '<svg viewBox="0 0 24 24"><path d="M6.5 4.5h4v15h-4zM13.5 4.5h4v15h-4z"/></svg>';
    const capa = (c, cls = '') => c ? `<img class="${cls}" src="${esc(c)}" alt="" onerror="this.outerHTML='<div class=&quot;sem-capa ${cls}&quot;>♪</div>'">` : `<div class="sem-capa ${cls}">♪</div>`;
    const mmss = x => `${Math.floor(x / 60)}:${String(Math.floor(x % 60)).padStart(2, '0')}`;
    let m = null, chave = '', fimPausa = 0, relogioP = 0;
    function cor(src) {        // cor média da capa para o brilho atrás (canvas pequeno; se a imagem não deixar ler, fica a padrão)
      if (!src) return;
      const im = new Image(); im.crossOrigin = 'anonymous';
      im.onload = () => { try { const c = document.createElement('canvas'); c.width = c.height = 8; const x = c.getContext('2d'); x.drawImage(im, 0, 0, 8, 8);
        const d = x.getImageData(0, 0, 8, 8).data; let r = 0, g = 0, b = 0; for (let i = 0; i < d.length; i += 4) { r += d[i]; g += d[i + 1]; b += d[i + 2]; }
        const n = d.length / 4; $p('p-brilho').style.setProperty('--p-cor', `rgb(${r / n | 0} ${g / n | 0} ${b / n | 0} / .55)`); } catch {} };
      im.src = src;
    }
    function cartas() {
      const ant = m.antes || [], pos = ['l1', 'r1', 'l2', 'r2'];
      $p('p-cartas').innerHTML = ant.slice(0, 4).map((a, i) => `<div class="carta ${pos[i]}">${capa(a.capa)}<b>${esc(a.titulo)}</b><small>${esc(a.artista)}</small></div>`).join('')
        + `<div class="carta c0">${capa(m.capa)}<b>${esc(m.titulo)}</b><small>${esc(m.artista)}${m.album && m.album !== m.titulo ? ' · ' + esc(m.album) : ''}</small></div>`;
      const sp = /spotify/i.test(m.player);
      $p('p-marca').innerHTML = sp ? `${SPOTIFY}<span>Spotify</span>` : `<span>tocando agora</span>`;
      cor(m.capa);
    }
    function barra() {
      const agora = m.tocando ? m.pos + (Date.now() / 1000 - m.t) : m.pos, p = m.dur ? Math.min(1, agora / m.dur) : 0;
      const ag = $p('p-agora');
      if (!ag.firstChild || ag.dataset.k !== chave) {
        ag.dataset.k = chave;
        ag.innerHTML = `${capa(m.capa, 'mini')}<div class="tx"><b>${esc(m.titulo)}</b><span>${esc(m.artista)}</span></div>
          <div style="display:flex;align-items:center;gap:.7vw"><span class="onda"><i></i><i></i><i></i><i></i><i></i></span><span class="tempo-m" id="p-tempo"></span></div><div class="prog"><i id="p-prog"></i></div>`;
      }
      $p('p-prog').style.setProperty('--p', p.toFixed(4));
      $p('p-tempo').textContent = m.dur ? `${mmss(Math.max(0, agora))} / ${mmss(m.dur)}` : '';
    }
    function aplicar() {
      const b = document.body, agora = Date.now();
      if (m && m.tocando) fimPausa = agora + 20000;
      const mostrar = !!m && (m.tocando || agora < fimPausa);
      b.classList.toggle('tocando', mostrar);
      b.classList.toggle('ativo-som', !!m && m.tocando);
      $p('p-pp').innerHTML = m && m.tocando ? PAUSA : PLAY;
      if (!m) return;
      const k = `${m.titulo}|${m.artista}`;
      if (k !== chave || $p('p-cartas').dataset.n !== String((m.antes || []).length)) { chave = k; $p('p-cartas').dataset.n = String((m.antes || []).length); cartas(); }
      barra();
    }
    window.musica = e => { m = e && e.titulo ? e : null; aplicar(); };
    clearInterval(relogioP); relogioP = setInterval(() => { if (!document.body.classList.contains('senha-aberta')) { if (m) barra(); aplicar(); } }, 1000);
    window.musicaPrevia = window.musica;
  }

  // ── Relógio: só o dígito que muda anima.
  const horaEl = document.getElementById('hora'), segEl = document.getElementById('seg');
  let anterior = '';
  function relogio() {
    const d = new Date(), t = d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    if (t !== anterior) {
      // HH:MM grandes; os segundos (depois do 2º ":") menores, no alto, como expoente.
      if (!horaEl.children.length) horaEl.innerHTML = [...t].map((ch, i) => ch === ':' ? (i > 3 ? '<span class="sep-seg"></span>' : '<span class="doispontos">:</span>')
        : `<span class="digito${i > 5 ? ' seg-dig' : ''}"></span>`).join('');
      [...t].forEach((ch, i) => {
        if (ch === ':' || ch === anterior[i]) return;
        const caixa = horaEl.children[i], velho = caixa.lastElementChild, novo = document.createElement('span');
        novo.textContent = ch;
        if (anterior) { novo.className = 'entra'; if (velho) { velho.className = 'sai'; setTimeout(() => velho.remove(), 800); } }
        caixa.append(novo);
      });
      const virouMinuto = t.slice(0, 5) !== anterior.slice(0, 5);
      anterior = t;
      if (virouMinuto) {
      const dia = d.toLocaleDateString('pt-BR', { weekday: 'long' }), resto = d.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long' });
      document.getElementById('data').innerHTML = `<b>${dia}</b>, ${resto}`;
      }
    }
    segEl.style.animationDelay = `-${d.getSeconds() + d.getMilliseconds() / 1000}s`;
  }
  // Alinha o tique na virada exata do segundo.
  relogio(); setTimeout(() => { relogio(); setInterval(relogio, 1000); }, 1000 - new Date().getMilliseconds() + 5);

  // ── Tempo (tempo() roda de novo quando chegam dados novos: o bloqueio pode durar horas)
  const C = window.CLIMA;
  let codAmbiente = null;
  let chuvaAmbiente = null;
  function tempo(primeira) {
    const C = window.CLIMA, R = window.RADAR; if (!C) return;
    const h = new Date().getHours(), noite = C.dia === undefined ? h >= 18 || h < 6 : !C.dia;
    const COD = +(new URLSearchParams(location.search).get('tempo') || C.codigo);  // ?tempo=302 simula (prévias)
    const chuvaLocal = !!R?.analisado && !!R?.perto?.aqui;
    if (COD !== codAmbiente || chuvaLocal !== chuvaAmbiente) {
      codAmbiente = COD; chuvaAmbiente = chuvaLocal;
      window.ambienteTempo(COD, document.getElementById('ambiente'), chuvaLocal);
    }
    // Radar: só aparece quando há chuva de verdade por perto (até 60 km)
    const p = R?.analisado && R.perto, rumo = { aproximando: ' · se aproximando', afastando: ' · se afastando' }[p?.tendencia] || '';
    const radar = !p || p.km > 60 ? '' : `<span class="radar">${p.km <= 3 ? 'chovendo aqui' : `chuva a ${p.km} km${rumo}`}</span>`;
    const condicao = p && p.km > 3 ? 'sem chuva detectada aqui' : C.condicao;
    const previsao = p && p.km > 3 ? `<span>previsão: ${C.condicao}</span>` : '';
    document.getElementById('clima').innerHTML = `${icone(COD, noite)}<span class="temp">${C.temp}°</span>
      <span class="txt"><span class="cond">${condicao}</span><span class="extra"><span>sensação ${C.sensacao}°</span><span>umidade ${C.umidade}%</span><span>vento ${C.vento} km/h</span>${previsao}${radar}</span></span>`;
    document.getElementById("dias").innerHTML = C.dias.slice(0, 3).map((d, i) =>
      `<div class="dia${primeira ? ' surge' : ''}" style="--i:${5 + i}">${icone(d.codigo, false)}<b>${i ? d.dia : 'hoje'}</b><span>${d.max}° <small>${d.min}°</small> · <small>${d.chuva}% chuva</small></span></div>`).join('');
  }
  if (C) tempo(true); else document.getElementById('clima').remove();
  // Relê os arquivos de dados a cada minuto (nunca com o campo de senha aberto).
  if (C) {
    const marca = () => `${window.CLIMA?.atualizado}|${window.RADAR?.quadros?.at(-1)?.t}`; let vista = marca();
    const reler = arq => new Promise(ok => { const s = document.createElement('script'); s.src = `file:///home/arthos/.cache/${arq}?${Date.now()}`;
      s.onload = s.onerror = () => { s.remove(); ok(); }; document.head.append(s); });
    setInterval(async () => {
      if (document.body.classList.contains('senha-aberta')) return;
      await reler('trava-clima.js'); await reler('trava-radar.js');
      if (marca() !== vista && !document.body.classList.contains('senha-aberta')) { vista = marca(); tempo(false); }
    }, 60000);
  }

  // ── Céu: recalcula a cada 5 min (o sol anda ~1,25° nesse tempo).
  const LAT = C?.lat ?? -3.72, LON = C?.lon ?? -38.52;
  const ceu = () => window.desenharCeu?.(LAT, LON, document.getElementById('ceu'), document.getElementById('chip-ceu'), document.getElementById('saudacao'));
  ceu(); setInterval(ceu, 300000);

  // ── Senha: estado vem do módulo auth_trava (via trava-saver). A página nunca vê a senha,
  // só a fase e quantos caracteres há. ?senha=digitando&n=6 simula (prévias).
  const pil = document.getElementById('pilula'), dica = document.getElementById('dica');

  let nAnterior = 0, fechar;
  const pHora = () => { const d = new Date(), p = n => String(n).padStart(2, '0');
    document.getElementById('p-hora').innerHTML = `${p(d.getHours())}:${p(d.getMinutes())}<sup>${p(d.getSeconds())}</sup>`;
    document.getElementById('p-data').innerHTML = document.getElementById('data').innerHTML; };
  setInterval(() => document.body.classList.contains('senha-aberta') && pHora(), 1000);
  window.senha = function (e) {
    clearTimeout(fechar);
    const aberto = e.fase !== 'fechado';
    document.body.classList.toggle('senha-aberta', aberto);
    document.body.dataset.senha = e.fase;
    if (!aberto) return;
    pHora();
    const n = e.n || 0, visiveis = Math.min(n, 14);
    if (e.fase === 'digitando' && n === 0) pil.innerHTML = '<span class="caret"></span>';
    else if (n !== nAnterior || e.fase !== 'digitando') {
      // Reaproveita as bolinhas que já existem: só a nova "brota".
      const atuais = pil.querySelectorAll('i').length;
      if (atuais > visiveis || pil.querySelector('.caret') || (e.fase !== 'digitando' && e.fase !== 'ok' && e.fase !== 'verificando')) pil.innerHTML = '';
      for (let k = pil.querySelectorAll('i').length; k < visiveis; k++) pil.insertAdjacentHTML('beforeend', `<i style="--k:${k}"></i>`);
      pil.querySelector('.mais')?.remove();
      if (n > 14) pil.insertAdjacentHTML('beforeend', `<span class="mais">+${n - 14}</span>`);
    }
    nAnterior = n;
    pil.style.setProperty('--meio', (pil.querySelectorAll('i').length - 1) / 2);
    dica.textContent = { digitando: n ? 'enter para desbloquear' : 'digite a senha', verificando: 'verificando…',
      erro: e.msg || 'senha incorreta — tente de novo', ok: 'desbloqueado' }[e.fase] || '';
    if (e.fase === 'erro') { pil.innerHTML = '<span class="caret"></span>'; nAnterior = 0; }
  };
  // Caps Lock: o trava-saver lê o estado da tecla e avisa aqui.
  window.capsLock = on => document.body.classList.toggle('caps', on);
  const simSenha = new URLSearchParams(location.search).get('senha');
  if (simSenha) window.senha({ fase: simSenha, n: +(new URLSearchParams(location.search).get('n') || 0) });

  document.addEventListener('visibilitychange', () => document.body.classList.toggle('pausado', document.hidden));
</script>
