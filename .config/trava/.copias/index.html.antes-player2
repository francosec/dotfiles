  [data-senha="ok"] .pilula i { background: #8ff0b8; box-shadow: 0 0 .6vw rgb(111 224 160 / .6); animation: recolhe .45s cubic-bezier(.6, 0, .4, 1) forwards; }
  @keyframes recolhe { to { transform: translateX(calc((var(--meio) - var(--k)) * 1.3vw)) scale(.2); opacity: 0; } }
  [data-senha="ok"] .dica { color: #8ff0b8; }
  .titulo { display: grid; justify-items: center; gap: .35vw; }
  .cartao .nome { font-size: 1.8vw; font-weight: 500; letter-spacing: .01em; }
  .pilula { width: 100%; height: 3.4vw; border-radius: 999px; display: flex; align-items: center; justify-content: center; gap: .6vw;
    background: linear-gradient(to bottom, rgb(0 0 0 / .32), rgb(0 0 0 / .18));
