  .onda { position: absolute; inset: .5vw; border-radius: 50%; border: 2px solid #6fe0a0; opacity: 0; pointer-events: none; }
  /* Acerto */
  [data-senha="ok"] .anel-v { animation: none; }
  [data-senha="ok"] .anel-v .giro { opacity: 0; }
  [data-senha="ok"] .anel-v .sucesso { opacity: 1; animation: desenha-ok .55s cubic-bezier(.65, 0, .35, 1) forwards; }
  @keyframes desenha-ok { to { stroke-dashoffset: 0; } }
  [data-senha="ok"] .selo .vidro { background: radial-gradient(circle at 35% 28%, rgb(111 224 160 / .35), rgb(111 224 160 / .08) 72%);
    border-color: rgb(111 224 160 / .6); box-shadow: inset 0 1px 0 rgb(255 255 255 / .18), 0 0 2.5vw rgb(111 224 160 / .35); }
  [data-senha="ok"] .cad * { stroke: #8ff0b8; }
