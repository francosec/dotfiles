  .pilula i { width: .7vw; aspect-ratio: 1; border-radius: 50%; background: var(--fg); box-shadow: 0 0 .5vw color-mix(in srgb, var(--fg) 40%, transparent);
    animation: brota .3s var(--entrada) both; }
  @keyframes brota { from { transform: scale(0); opacity: 0; } 60% { transform: scale(1.3); } to { transform: none; opacity: 1; } }
