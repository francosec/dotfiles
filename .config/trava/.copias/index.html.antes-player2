<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tela de bloqueio</title>
<script>
  // ?agora=2026-11-17T21:00 simula outro horário (prévias).
  const simulado = new URLSearchParams(location.search).get('agora');
  if (simulado) { const D = Date, delta = new D(simulado) - D.now();
    window.Date = class extends D { constructor(...a) { a.length ? super(...a) : super(D.now() + delta); } static now() { return D.now() + delta; } }; }
</script>
<!-- Cores do pywal (--background, --foreground, --color0..15). -->
<link rel="stylesheet" href="file:///home/arthos/.cache/wal/colors.css">
<style>
  :root {
    --fg: var(--foreground, #e2e2e2);
    --bg: var(--background, #0e0e0e);
    --suave: color-mix(in srgb, var(--fg) 72%, transparent);
    --fraco: color-mix(in srgb, var(--fg) 42%, transparent);
    --linha: color-mix(in srgb, var(--fg) 14%, transparent);
    --vidro: color-mix(in srgb, var(--bg) 38%, transparent);
    --entrada: cubic-bezier(.16, 1, .3, 1);
  }
  * { margin: 0; box-sizing: border-box; }
  html, body { height: 100%; overflow: hidden; background: #000; color: var(--fg);
    font-family: "Adwaita Sans", "Inter", system-ui, sans-serif; cursor: none; -webkit-font-smoothing: antialiased; }

  /* Fundo: wallpaper desfocado (lockwall) com zoom lento; só transform, barato para a GPU. */
  .fundo { position: fixed; inset: -3%; background: var(--bg) var(--img-fundo, url("file:///home/arthos/.cache/trava-fundo.jpg")) center / cover;
    animation: respirar 48s ease-in-out infinite alternate; will-change: transform; }
  .vinheta { position: fixed; inset: 0; background: radial-gradient(ellipse at 50% 45%, transparent 30%, rgb(0 0 0 / .6) 100%); }
  @keyframes respirar { from { transform: scale(1); } to { transform: scale(1.06) translate(-1%, .6%); } }

  main { position: relative; height: 100%; display: grid; place-items: center; }
  .palco { display: grid; grid-template-columns: auto auto; align-items: center; gap: 5.5vw; }
  /* O céu fica numa faixa no alto (window.CEU_GEO): o caminho do sol não cruza a foto nem os textos. */
  .lado { position: relative; display: grid; }

  /* ── Player (Spotify ou outro player): ocupa o lugar do porta-retrato enquanto toca. Só transform/opacity. */
  .palco { transition: opacity .55s cubic-bezier(.2, .8, .2, 1), transform .8s cubic-bezier(.2, .8, .2, 1); }
  body.tocando .palco { transform: translateY(-5.5vh) scale(.88); }
  .player { position: fixed; left: 50%; bottom: 3.2vh; translate: -50% 0; display: grid; grid-template-columns: 30vw 29vw; align-items: center; gap: 3vw;
    opacity: 0; transform: translateY(3vh); pointer-events: none; transition: opacity .7s ease, transform .8s cubic-bezier(.2, .8, .2, 1); }
  body.tocando .player { opacity: 1; transform: none; }
  .p-col { position: relative; display: grid; gap: 1.1vw; justify-items: start; }
  .p-brilho { position: absolute; left: 15vw; top: 50%; width: 26vw; height: 26vw; translate: -50% -50%; border-radius: 50%; opacity: .55;
    background: radial-gradient(circle, var(--p-cor, rgb(255 180 90 / .5)), transparent 68%); }
  .p-marca { position: relative; display: flex; align-items: center; gap: .55vw; font-size: 1.15vw; font-weight: 600; letter-spacing: -.01em; color: var(--suave); }
