  .dica { font-size: .95vw; color: var(--fraco); min-height: 1.3vw; transition: color .3s; }
  [data-senha="erro"] .cartao { animation: tremer .5s cubic-bezier(.36, .07, .19, .97) both; border-color: rgb(224 108 117 / .55); }
