  .entrada .cad * { fill: none; stroke: var(--suave); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: stroke .4s; }
  .entrada .cad .alca { transform-origin: 16.5px 11px; transition: transform .7s cubic-bezier(.34, 1.8, .5, 1) .1s; }
  .trilho-senha { position: relative; width: 19vw; height: 2.4vw; display: grid; place-items: center; overflow: hidden; }
  .trilho-senha .fio, .trilho-senha .fio-cor { position: absolute; left: 0; right: 0; bottom: 0; height: 1px; }
  .trilho-senha .fio { background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--fg) 35%, transparent) 15%, color-mix(in srgb, var(--fg) 35%, transparent) 85%, transparent); transition: opacity .3s; }
  .trilho-senha .fio-cor { height: 2px; transform: scaleX(0); opacity: 0;
    background: linear-gradient(90deg, transparent, #6fe0a0 18%, #a8f5c8 50%, #6fe0a0 82%, transparent); }
  .pontos { display: flex; gap: .7vw; align-items: center; height: 100%; }
