! X colors.
! Generated by 'wal'
*foreground:        #95e2f2
*background:        #020A13
*.foreground:       #95e2f2
*.background:       #020A13
emacs*foreground:   #95e2f2
emacs*background:   #020A13
URxvt*foreground:   #95e2f2
XTerm*foreground:   #95e2f2
UXTerm*foreground:  #95e2f2
URxvt*background:   [100]#020A13
XTerm*background:   #020A13
UXTerm*background:  #020A13
URxvt*cursorColor:  #95e2f2
XTerm*cursorColor:  #95e2f2
UXTerm*cursorColor: #95e2f2
URxvt*borderColor:  [100]#020A13

! Colors 0-15.
*.color0: #020A13
*color0:  #020A13
*.color1: #134E8D
*color1:  #134E8D
*.color2: #1B4290
*color2:  #1B4290
*.color3: #215CA6
*color3:  #215CA6
*.color4: #1968B2
*color4:  #1968B2
*.color5: #2174CD
*color5:  #2174CD
*.color6: #2497EA
*color6:  #2497EA
*.color7: #95e2f2
*color7:  #95e2f2
*.color8: #689ea9
*color8:  #689ea9
*.color9: #134E8D
*color9:  #134E8D
*.color10: #1B4290
*color10:  #1B4290
*.color11: #215CA6
*color11:  #215CA6
*.color12: #1968B2
*color12:  #1968B2
*.color13: #2174CD
*color13:  #2174CD
*.color14: #2497EA
*color14:  #2497EA
*.color15: #95e2f2
*color15:  #95e2f2

! Black color that will not be affected by bold highlighting.
*.color66: #020A13
*color66:  #020A13

! Xclock colors.
XClock*foreground: #95e2f2
XClock*background: #020A13
XClock*majorColor:  rgba:95/e2/f2/ff
XClock*minorColor:  rgba:95/e2/f2/ff
XClock*hourColor:   rgba:95/e2/f2/ff
XClock*minuteColor: rgba:95/e2/f2/ff
XClock*secondColor: rgba:95/e2/f2/ff

! Set depth to make transparency work.
URxvt*depth: 32
