#!/bin/sh

# Inverte o scroll dos mouses cujo nome casa com SCROLL_INVERTIDO (regex, em ~/.local/share/dispositivos.env).
. "$HOME/.local/share/dispositivos.env" 2>/dev/null
[ -n "$SCROLL_INVERTIDO" ] || exit 0

while true; do
    for id in $(xinput list | awk -v p="$SCROLL_INVERTIDO" '
    /slave  pointer/ && $0 ~ p {
        match($0,/id=[0-9]+/)
        print substr($0,RSTART+3,RLENGTH-3)
    }'); do

        current=$(xinput get-button-map "$id" 2>/dev/null)

        if [ "$current" != "1 2 3 5 4 6 7 8 9" ]; then
            xinput set-button-map "$id" 1 2 3 5 4 6 7 8 9 >/dev/null 2>&1
        fi
    done

    sleep 2
done
