#!/bin/sh
# Atualiza a tela de bloqueio do betterlockscreen com o wallpaper só no
# monitor principal; os outros monitores ficam pretos.
# Uso: lockwall [imagem]   (sem argumento usa o wallpaper atual do pywal)
# Rode de novo se mudar a disposição dos monitores.

img="${1:-$(cat "$HOME/.cache/wal/wal")}"
[ -f "$img" ] || { echo "lockwall: imagem não encontrada: $img" >&2; exit 1; }

canvas="$HOME/.cache/betterlockscreen-canvas.png"
# Tom do terminal (st): blur suave + cor de fundo do pywal por cima, como o picom faz no st.
fundo=$(. "$HOME/.cache/wal/colors.sh" 2>/dev/null; echo "${background:-#0E0E0E}")

# Tamanho total da área de trabalho (igual ao que o betterlockscreen usa).
total=$(xdpyinfo | awk '/dimensions:/ {print $2}')

# Geometria e índice (1-based, ordem do --listactivemonitors) do monitor principal.
set -- $(xrandr --listactivemonitors | awk 'NR>1 && $2 ~ /\*/ {
  split($3, g, /[x+]/); sub(/\/.*/, "", g[1]); sub(/\/.*/, "", g[2])
  print NR-1, g[1], g[2], g[3], g[4] }')
id=$1 w=$2 h=$3 x=$4 y=$5
[ -n "$h" ] || { echo "lockwall: monitor principal não encontrado" >&2; exit 1; }

magick -size "$total" xc:black \
  \( "$img" -resize "${w}x${h}^" -gravity center -extent "${w}x${h}" \) \
  -gravity NorthWest -geometry "+${x}+${y}" -composite "$canvas" || exit 1

# Fundo da tela de bloqueio nova (trava-i3lock): wallpaper desfocado e escurecido no principal.
magick -size "$total" xc:black \
  \( "$img" -resize "${w}x${h}^" -gravity center -extent "${w}x${h}" -scale 25% -blur 0x7 -resize "${w}x${h}!" -fill "$fundo" -colorize 55% -attenuate 0.12 +noise Gaussian \) \
  -gravity NorthWest -geometry "+${x}+${y}" -composite "$HOME/.cache/trava.png" || exit 1

betterlockscreen -u "$canvas" --span --display "$id"
