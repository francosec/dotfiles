#!/usr/bin/env python3
# Milissegundos sem teclado/mouse no X (como o xprintidle, que não está instalado). Usa libXss.
import ctypes as C
x = C.cdll.LoadLibrary("libX11.so.6"); s = C.cdll.LoadLibrary("libXss.so.1")
class Info(C.Structure):
    _fields_ = [("window", C.c_ulong), ("state", C.c_int), ("kind", C.c_int),
                ("til_or_since", C.c_ulong), ("idle", C.c_ulong), ("eventMask", C.c_ulong)]
x.XOpenDisplay.restype = C.c_void_p
x.XDefaultRootWindow.argtypes = [C.c_void_p]; x.XDefaultRootWindow.restype = C.c_ulong
s.XScreenSaverAllocInfo.restype = C.POINTER(Info)
s.XScreenSaverQueryInfo.argtypes = [C.c_void_p, C.c_ulong, C.POINTER(Info)]
d = x.XOpenDisplay(None)
if not d: raise SystemExit(1)
i = s.XScreenSaverAllocInfo()
s.XScreenSaverQueryInfo(d, x.XDefaultRootWindow(d), i)
print(i.contents.idle)
