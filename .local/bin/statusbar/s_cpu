#!/bin/sh
# Compara com a leitura da execução anterior (guardada em RAM),
# em vez de dormir 0,5 s: mede a média dos últimos 5 s.
f="${XDG_RUNTIME_DIR:-/tmp}/s_cpu.prev"
read -r _ a b c idle _ < /proc/stat
total=$((a + b + c + idle))
if [ -r "$f" ]; then read -r ptotal pidle < "$f"; else ptotal=0 pidle=0; fi
echo "$total $idle" > "$f"
dt=$((total - ptotal)); di=$((idle - pidle))
if [ "$dt" -gt 0 ]; then cpu=$((100 * (dt - di) / dt)); else cpu=0; fi
echo " $cpu%"
"${0%/*}/barhist" cpu "$cpu"

case $BLOCK_BUTTON in
    1) setsid -f barpop cpu >/dev/null 2>&1 ;;
    3) setsid -f barpop cpu >/dev/null 2>&1 ;;
    6) st -e nvim "$0" ;;
esac
