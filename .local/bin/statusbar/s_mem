mem=`free -h | awk '/^Mem/ { print $3 }' | sed 's/i//g'`
echo -e "󰍛 $mem"
"${0%/*}/barhist" mem "$(awk '/^MemTotal/{t=$2} /^MemAvailable/{a=$2} END{printf "%.0f", (t-a)*100/t}' /proc/meminfo)"

case $BLOCK_BUTTON in
    1) setsid -f barpop mem >/dev/null 2>&1 ;;
    3) setsid -f barpop mem >/dev/null 2>&1 ;;
    6) st -e nvim "$0" ;;
esac
