#!/bin/sh
# Uma chamada ao playerctl; sai vazio se o Spotify não estiver aberto.
meta=$(playerctl -p spotify metadata --format '{{artist}} - {{title}}' 2>/dev/null)
if [ -n "$meta" ]; then echo " $meta "; else echo ""; fi

case $BLOCK_BUTTON in
	  1) setsid -f barpop spotify >/dev/null 2>&1 ;;
	  2|3) playerctl play-pause ;;
	  6) st -e nvim "$0" ;;
esac
