#!/bin/sh
# Clique primeiro: abre o terminal na hora, sem esperar a contagem (~2 s).
case $BLOCK_BUTTON in
    1) setsid -f barpop upd >/dev/null 2>&1 ;;
    2) xdotool key --clearmodifiers "Super_L+Shift+Return" ;;
    3) setsid -f barpop upd >/dev/null 2>&1 ;;
    6) st -e nvim "$0" ;;
esac

# Guarda a lista (R = repositório, A = AUR) para o pop-up (barpop upd) abrir na hora.
d="${XDG_RUNTIME_DIR:-/tmp}/barhist"; mkdir -p "$d"
{ checkupdates 2>/dev/null | sed 's/^/R /'; yay -Qua 2>/dev/null | sed 's/^/A /'; } > "$d/upd.t" && mv "$d/upd.t" "$d/upd"
NUM_UPDATES=$(wc -l < "$d/upd")
if [ "$NUM_UPDATES" -gt 0 ]; then
    echo " $NUM_UPDATES"
fi
