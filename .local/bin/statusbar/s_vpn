#!/bin/sh
# Uma chamada ao mullvad (antes eram duas).
st=$(mullvad status 2>/dev/null)
case $st in
    Connected*) ;;
    *) echo ""; exit 0 ;;
esac

visible=$(printf '%s\n' "$st" | sed -n 's/.*Visible location:[ \t]*//p')
country=$(echo "$visible" | awk -F, '{print $1}' | xargs)
city=$(echo "$visible" | awk -F, '{print $2}' | sed -E 's/\..*//; s/^[ \t]*//' | xargs)

echo " $country, $city"

case $BLOCK_BUTTON in
    1|3) setsid -f barpop vpn >/dev/null 2>&1 ;;
    6) st -e nvim "$0" ;;
esac
