#!/usr/bin/env bash

bar_color="#ffffff"
hi_bar_color="#ffffff"
volume_step=5
max_volume=125

dev="@DEFAULT_AUDIO_SOURCE@"

# Lê volume e mudo numa chamada só ao wpctl.
# Saída: "Volume: 0.48" ou "Volume: 0.48 [MUTED]"
function read_state {
    set -- $(wpctl get-volume "$dev")
    local v="${2%.*}${2#*.}"
    v=${v#0}; v=${v#0}
    volume=$v
    if [ "$3" = "[MUTED]" ]; then mute=yes; else mute=no; fi
}

# Returns a mute icon, a volume-low icon, or a volume-high icon, depending on the volume
function get_volume_icon {
    read_state
    if [ "$volume" -eq 0 ] || [ "$mute" == "yes" ] ; then
        volume_icon=""
    elif [ "$volume" -le 25 ]; then
        volume_icon=""
    elif [ "$volume" -le 50 ]; then
        volume_icon=""
    elif [ "$volume" -le 100 ]; then
        volume_icon=""
    elif [ "$volume" -gt 100 ]; then
        volume_icon=""
    fi
}

# Displays a volume notification using dunstify
function show_volume_notif {
    get_volume_icon
    if [ "$volume" -gt 100 ]; then
        dunstify -t 1000 -r 2593 -u normal "$volume_icon  $volume%" -h int:value:$volume -h string:hlcolor:$hi_bar_color
    else
        dunstify -t 1000 -r 2593 -u normal "$volume_icon  $volume%" -h int:value:$volume -h string:hlcolor:$bar_color
    fi
}

# Main function - Takes user input, "up", "down" or "mute"
case $1 in
    up)
    # Unmutes and increases volume, then displays the notification
    wpctl set-mute "$dev" 0
    wpctl set-volume -l "$(printf '%d.%02d' $((max_volume / 100)) $((max_volume % 100)))" "$dev" "$volume_step%+"
    show_volume_notif
    kill -43 $(pidof dwmblocks)
    ;;

    down)
    # Lowers volume and displays the notification
    wpctl set-volume "$dev" "$volume_step%-"
    show_volume_notif
    kill -43 $(pidof dwmblocks)
    ;;

    mute)
    # Toggles mute and displays the notification
    wpctl set-mute "$dev" toggle
    show_volume_notif
    kill -43 $(pidof dwmblocks)
    ;;
esac
