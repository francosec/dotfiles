#!/bin/sh
# Chamado pelo xautolock depois de 10 min sem teclado/mouse (ver alwayslock).
# Não bloqueia com vídeo/música tocando (qualquer player MPRIS: YouTube/Prime no Brave, mpv, Spotify).
# Quando o player pausa ou acaba, espera 1 min: se ninguém mexer no teclado/mouse, bloqueia.
export DISPLAY="${DISPLAY:-:0}"
pgrep -x xsecurelock >/dev/null && exit 0
tocando() { playerctl -a status 2>/dev/null | grep -qx Playing; }
if tocando; then
  while tocando; do sleep 30; done
  sleep 60
  # mexeu no teclado/mouse no último minuto e meio: a pessoa voltou, não bloqueia (o xautolock recomeça a contar)
  [ "$(ocioso-ms 2>/dev/null || echo 999999999)" -lt 90000 ] && exit 0
fi
pgrep -x xsecurelock >/dev/null || exec betterlockscreen -l
