#!/bin/sh
# Lista as fotos do porta-retrato da tela de bloqueio em ~/.cache/trava-fotos.js (window.FOTOS).
# Pasta: ~/Pictures/porta-retrato (jpg, jpeg, png, webp). Rode de novo ao adicionar fotos.
pasta="$HOME/Pictures/porta-retrato"
saida="$HOME/.cache/trava-fotos.js"
{
  printf 'window.FOTOS = ['
  find "$pasta" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) 2>/dev/null |
    sort | while IFS= read -r f; do printf '"file://%s",' "$f"; done
  printf '];\n'
} > "$saida"
