#!/usr/bin/env python3
# Radar de chuva da tela de bloqueio → ~/.cache/trava-radar.js (window.RADAR).
# Lista os quadros recentes do RainViewer (as páginas carregam as imagens direto) e mede, no quadro
# mais novo, onde está a chuva mais próxima de casa: distância, direção e se vem chegando.
# Local: LAT/LON do ambiente ou de ~/.config/trava-local. Sem rede: mantém o arquivo anterior.
import io, json, math, os, sys, urllib.request
from concurrent.futures import ThreadPoolExecutor

SAIDA = os.path.expanduser('~/.cache/trava-radar.js')
RAIO_KM = 150          # até onde procurar chuva
Z, T = 7, 512          # o radar grátis vai até o zoom 7; ladrilho de 512 px ≈ 610 m por ponto
VENTOS = ['norte', 'nordeste', 'leste', 'sudeste', 'sul', 'sudoeste', 'oeste', 'noroeste']

def local():
    lat, lon = os.environ.get('LAT'), os.environ.get('LON')
    if not lat:
        try:
            for linha in open(os.path.expanduser('~/.config/trava-local')):
                k, _, v = linha.strip().partition('=')
                if k == 'LAT': lat = v.strip('"\'')
                if k == 'LON': lon = v.strip('"\'')
        except OSError:
            pass
    return (float(lat), float(lon)) if lat and lon else None

def baixar(url, limite=6):
    req = urllib.request.Request(url, headers={'User-Agent': 'trava-radar/1 (tela de bloqueio pessoal)'})
    with urllib.request.urlopen(req, timeout=limite) as r:
        return r.read()

def analisar(host, caminho, lat, lon):
    """Chuva mais próxima no quadro: {km, dx, dy, forte, cobertura} ou None (nada no raio)."""
    from PIL import Image, ImageFilter
    mundo = T * 2 ** Z
    gx = (lon + 180) / 360 * mundo
    gy = (1 - math.log(math.tan(math.radians(lat)) + 1 / math.cos(math.radians(lat))) / math.pi) / 2 * mundo
    km_ponto = 156543.03392 * math.cos(math.radians(lat)) / 2 ** Z / (T / 256) / 1000
    r = int(RAIO_KM / km_ponto) + 2
    x0, y0, x1, y1 = int(gx) - r, int(gy) - r, int(gx) + r, int(gy) + r
    ladrilhos = [(tx, ty) for tx in range(x0 // T, x1 // T + 1) for ty in range(y0 // T, y1 // T + 1)]
    # 0_0 = sem suavizar: a borda da chuva fica onde o radar mediu
    pega = lambda t: Image.open(io.BytesIO(baixar(f'{host}{caminho}/{T}/{Z}/{t[0]}/{t[1]}/2/0_0.png'))).convert('RGBA')
    with ThreadPoolExecutor(4) as ex:
        imagens = list(ex.map(pega, ladrilhos))
    tela = Image.new('RGBA', (x1 - x0, y1 - y0))
    for (tx, ty), im in zip(ladrilhos, imagens):
        tela.paste(im, (tx * T - x0, ty * T - y0))
    # Chuva = cor cheia (azul em diante). O bege translúcido é eco fraco/nuvem, não conta.
    r_, g_, b_, a_ = tela.split()
    chuva = a_.point(lambda v: 255 if v >= 250 else 0)
    # Tira pontos soltos (ruído do radar): só vale quem tem vizinhos também com chuva.
    vizinhos = chuva.filter(ImageFilter.BoxBlur(1))
    larg, alt = tela.size
    cx, cy = gx - x0, gy - y0
    pc, pv, pr, pg = chuva.load(), vizinhos.load(), r_.load(), g_.load()
    melhor, perto25, forte, validos = None, 0, False, {}
    for y in range(alt):
        for x in range(larg):
            if not pc[x, y] or pv[x, y] < 110:
                continue
            dx, dy = (x + .5 - cx) * km_ponto, (y + .5 - cy) * km_ponto
            d = math.hypot(dx, dy)
            if d > RAIO_KM:
                continue
            if d <= 25:
                perto25 += 1
            if d <= 30 and pr[x, y] > 200:      # amarelo/laranja/vermelho = chuva forte
                forte = True
            validos[(x, y)] = (d, dx, dy, pr[x, y] > 200)
            if melhor is None or d < melhor[0]:
                melhor = (d, dx, dy)
    if not melhor:
        return None
    # Áreas de chuva (pontos vizinhos juntos): o ponto mais próximo de casa de cada uma.
    celulas, vistos = [], set()
    for p0 in validos:
        if p0 in vistos:
            continue
        pilha, pts = [p0], []
        vistos.add(p0)
        while pilha:
            p = pilha.pop(); pts.append(validos[p])
            for ox in (-2, -1, 0, 1, 2):
                for oy in (-2, -1, 0, 1, 2):
                    q = (p[0] + ox, p[1] + oy)
                    if q in validos and q not in vistos:
                        vistos.add(q); pilha.append(q)
        if len(pts) < 3:
            continue
        d, cdx, cdy, _ = min(pts)
        celulas.append({'km': round(d), 'dx': round(cdx, 1), 'dy': round(-cdy, 1),
                        'direcao': VENTOS[round(math.degrees(math.atan2(cdx, -cdy)) / 45) % 8],
                        'forte': any(p[3] for p in pts), 'area': round(len(pts) * km_ponto ** 2)})
    celulas.sort(key=lambda c: c['km'])
    d, dx, dy = melhor
    area25 = math.pi * 25 ** 2 / km_ponto ** 2
    return {'km': round(d), 'dx': round(dx, 1), 'dy': round(-dy, 1),      # dx = leste, dy = norte (km)
            'direcao': VENTOS[round(math.degrees(math.atan2(dx, -dy)) / 45) % 8],
            'forte': forte, 'cobertura': round(100 * perto25 / area25), 'celulas': celulas[:20]}

def main():
    mapas = json.loads(baixar('https://api.rainviewer.com/public/weather-maps.json'))
    quadros = [{'t': q['time'], 'p': q['path']} for q in (mapas.get('radar', {}).get('past') or [])[-12:]]
    if not quadros:
        return 1
    radar = {'host': mapas['host'], 'quadros': quadros, 'raio': RAIO_KM, 'perto': None, 'celulas': [], 'analisado': False}
    onde = local()
    if onde:
        try:
            agora = analisar(mapas['host'], quadros[-1]['p'], *onde)
            radar['analisado'] = True
            if agora:
                # Tendência: compara com o quadro de ~30 min antes (3 quadros atrás).
                antes = analisar(mapas['host'], quadros[-4]['p'], *onde) if len(quadros) >= 4 else None
                if antes:
                    delta = antes['km'] - agora['km']
                    agora['tendencia'] = 'aproximando' if delta >= 5 else 'afastando' if delta <= -5 else 'parada'
                else:
                    agora['tendencia'] = 'nova'
                radar['celulas'] = agora.pop('celulas', [])
                radar['perto'] = agora
        except Exception as e:                      # sem análise a página mostra só o mapa
            print(f'trava-radar: análise falhou: {e}', file=sys.stderr)
    tmp = SAIDA + '.tmp'
    with open(tmp, 'w') as f:
        f.write('window.RADAR = ' + json.dumps(radar, ensure_ascii=False) + ';\n')
    os.replace(tmp, SAIDA)
    return 0

if __name__ == '__main__':
    try:
        sys.exit(main())
    except Exception as e:
        print(f'trava-radar: {e}', file=sys.stderr)
        sys.exit(1)
