#!/usr/bin/env python3
"""vinil: abre o player de vinil (radar.html da trava) em tela cheia no monitor escolhido.

Uso: vinil 1|2|3      telas da esquerda para a direita (mesma numeração do tela-desliga)
     vinil cursor     monitor onde está o cursor
     vinil fechar
Repetir no mesmo monitor fecha; em outro monitor, o player muda de tela (um por vez).
É uma janela comum em tela cheia, chamada "Vinil": aparece em "Janela" ao compartilhar a tela
(Meet, Discord, OBS) e fecha também com Super+Shift+Q. Fecha sozinha quando a tela é bloqueada.
"""
import fcntl, glob, os, re, signal, subprocess, sys, time

SAIDAS = {'1': r'(?:eDP|LVDS)\S*', '2': r'HDMI-1', '3': r'DVI-I-2-2'}
PASTA = os.environ.get('XDG_RUNTIME_DIR', '/tmp')
PID, TRINCO = os.path.join(PASTA, 'vinil.pid'), os.path.join(PASTA, 'vinil.lock')


def avisar(texto):
    print('vinil:', texto, file=sys.stderr)
    subprocess.run(['notify-send', 'Vinil', texto])
    sys.exit(1)


def bloqueada():
    for c in glob.glob('/proc/[0-9]*/comm'):
        try:
            if open(c).read().strip() == 'xsecurelock':
                return True
        except OSError:
            pass
    return False


def aberto():
    """(pid, saída) do player aberto, ou None."""
    try:
        pid, saida = open(PID).read().split()
        if b'vinil' in open(f'/proc/{pid}/cmdline', 'rb').read():
            return int(pid), saida
    except (OSError, ValueError):
        pass
    return None


def fechar(pid):
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    for _ in range(40):
        if not os.path.exists(f'/proc/{pid}'):
            return
        time.sleep(.05)
    os.kill(pid, signal.SIGKILL)


def telas():
    out = subprocess.run(['xrandr', '--current'], capture_output=True, text=True, timeout=5).stdout
    return {m[1]: tuple(map(int, m.group(4, 5, 2, 3)))
            for m in re.finditer(r'^(\S+) connected(?: primary)? (\d+)x(\d+)\+(\d+)\+(\d+)', out, re.M)}


arg = sys.argv[1] if len(sys.argv) == 2 else ''
if arg not in (*SAIDAS, 'cursor', 'fechar'):
    sys.exit(__doc__)
trinco = open(TRINCO, 'w')
fcntl.flock(trinco, fcntl.LOCK_EX)      # atalho repetido rápido: um de cada vez
atual = aberto()
if arg == 'fechar':
    if atual:
        fechar(atual[0])
    sys.exit(0)

mons = telas()
if arg == 'cursor':
    p = dict(l.split('=') for l in subprocess.run(['xdotool', 'getmouselocation', '--shell'], capture_output=True, text=True).stdout.split())
    cx, cy = int(p['X']), int(p['Y'])
    saida = next((n for n, (x, y, w, h) in mons.items() if x <= cx < x + w and y <= cy < y + h), None)
else:
    saida = next((n for n in mons if re.fullmatch(SAIDAS[arg], n)), None)
if atual:
    fechar(atual[0])
    if atual[1] == saida:
        sys.exit(0)
if not saida:
    avisar('Monitor desligado ou desconectado.')
if bloqueada():
    sys.exit(1)
x, y, w, h = mons[saida]

# solta do terminal: senão o dwm (swallow) esconderia o terminal de onde foi chamado
if os.fork():
    os._exit(0)
os.setsid()

import warnings
warnings.simplefilter('ignore')
import gi
gi.require_version('Gtk', '3.0'); gi.require_version('GdkX11', '3.0')
from gi.repository import Gtk, GdkX11, GLib


def cursor():
    p = dict(l.split('=') for l in subprocess.run(['xdotool', 'getmouselocation', '--shell'], capture_output=True, text=True).stdout.split())
    return p['X'], p['Y']


# Janela comum (não override-redirect): só assim Meet, Discord e OBS a listam para compartilhar.
# O dwm abre janela nova na tela do cursor: leva o cursor até lá e devolve depois.
GLib.set_prgname('vinil')
volta = cursor()
subprocess.run(['xdotool', 'mousemove', str(x + w // 2), str(y + h // 2)])
time.sleep(.2)
jan = Gtk.Window()
jan.set_title('Vinil')
jan.set_wmclass('vinil', 'Vinil')
jan.set_app_paintable(True)
jan.connect('draw', lambda _w, c: (c.set_source_rgb(0, 0, 0), c.paint(), False)[-1])
jan.connect('destroy', lambda *_: Gtk.main_quit())
jan.set_default_size(w, h)
jan.fullscreen()
jan.show_all()
fim = time.time() + .7
while time.time() < fim:            # espera o dwm aplicar a tela cheia
    while Gtk.events_pending():
        Gtk.main_iteration()
    time.sleep(.02)
subprocess.run(['xdotool', 'mousemove', *volta])

env = dict(os.environ, XSCREENSAVER_WINDOW=str(jan.get_window().get_xid()), TRAVA_SO_PLAYER='1')
filho = subprocess.Popen([os.path.expanduser('~/.local/bin/trava-saver')], env=env, close_fds=True)
with open(PID, 'w') as f:
    f.write(f'{os.getpid()} {saida}')
trinco.close()


def vigiar():
    if filho.poll() is not None or bloqueada():
        Gtk.main_quit()
        return False
    return True


GLib.timeout_add(1000, vigiar)
for s in (signal.SIGTERM, signal.SIGINT):
    signal.signal(s, lambda *_: Gtk.main_quit())
Gtk.main()
filho.terminate()
try:
    filho.wait(1)
except subprocess.TimeoutExpired:
    filho.kill()
try:
    if open(PID).read().split()[0] == str(os.getpid()):
        os.remove(PID)
except (OSError, IndexError):
    pass
