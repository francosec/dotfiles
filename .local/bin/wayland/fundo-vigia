#!/bin/sh
# Vigia as telas: quando um monitor sai/volta (ex.: tela principal trocando de HDMI e voltando),
# reaplica o papel de parede para o fundo não ficar cortado.
# Escuta o socket de eventos do Hyprland. Uma cópia por sessão.
exec python3 - <<'PYTHON'
import fcntl
import os
from pathlib import Path
import socket
import subprocess
import json
import time

# Sem a tela principal (ex.: LG no outro PC), a Philips encosta no notebook (base alinhada: a borda toda do notebook passa)
# para o cursor passar direto; com ela de volta, volta à direita da LG.
def encaixa():
    try:
        saida = subprocess.run(["hyprctl", "-j", "monitors"], capture_output=True, text=True).stdout
        nomes = {m["name"] for m in json.loads(saida)}
    except (OSError, ValueError):
        return
    if "DVI-I-2" not in nomes:
        return
    pos = "3926x180" if "HDMI-A-1" in nomes else "1366x24"
    subprocess.run(["hyprctl", "eval", 'hl.monitor({ output = "DVI-I-2", mode = "1920x1080@75", '
                    f'position = "{pos}", scale = 1 }})'], stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, check=False)

pasta = Path(os.environ["XDG_RUNTIME_DIR"]) / "hypr" / os.environ["HYPRLAND_INSTANCE_SIGNATURE"]
# O lock na pasta da sessão evita duas cópias sem criar arquivo.
fd = os.open(pasta, os.O_RDONLY | os.O_DIRECTORY)
try:
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    raise SystemExit(0)

encaixa()
with socket.socket(socket.AF_UNIX) as conexao:
    conexao.connect(str(pasta / ".socket2.sock"))
    with conexao.makefile("rb") as eventos:
        for linha in eventos:
            evento = linha.partition(b">>")[0]
            if evento == b"configreloaded":
                encaixa()  # o reload volta a Philips para a posição da config
            elif evento in (b"monitoradded", b"monitorremoved"):
                time.sleep(2)  # espera a troca assentar
                encaixa()
                subprocess.run(["cava-fundo"], stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, check=False)
                subprocess.run(["fundo-wayland"], stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, check=False)
PYTHON
