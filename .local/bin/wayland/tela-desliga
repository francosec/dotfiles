#!/bin/sh
# tela-desliga 1|2|3 [ligar|desligar|estado] no Hyprland (1 notebook, 2 tela principal, 3 tela direita). Sem argumento: alterna.
case "$1" in 1) m=eDP-1 ;; 2) m=HDMI-A-1 ;; 3) m=DVI-I-2 ;; *) echo "uso: tela-desliga 1|2|3 [ligar|desligar|estado]" >&2; exit 2 ;; esac
estado() { hyprctl monitors -j | python3 -c "import json,sys; print(next((('ligada' if x['dpmsStatus'] else 'desligada') for x in json.load(sys.stdin) if x['name']=='$m'),'?'))"; }
case "${2:-alternar}" in
  estado) estado; exit 0 ;;
  ligar) a=on ;; desligar) a=off ;; *) [ "$(estado)" = ligada ] && a=off || a=on ;;
esac
hyprctl eval "hl.dispatch(hl.dsp.dpms({ monitor = '$m', action = '$a' }))"
